  "testPresets": [
    {
      "name": "apricotfields-macos-metal-asan",
      "configurePreset": "apricotfields-macos-metal-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
