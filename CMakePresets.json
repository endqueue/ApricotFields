{
  "version": 6,
  "configurePresets": [
    {
      "name": "apricotfields-windows-d3d12",
      "displayName": "ApricotFields Windows D3D12",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-d3d12",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "D3D12",
        "LANGUAGE_BINDING": "NONE",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "apricotfields-windows-vulkan",
      "displayName": "ApricotFields Windows Vulkan",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-vulkan",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Vulkan",
        "LANGUAGE_BINDING": "NONE",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "apricotfields-linux-vulkan",
      "displayName": "ApricotFields Linux Vulkan",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-linux-vulkan",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Vulkan",
        "LANGUAGE_BINDING": "NONE",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "apricotfields-macos-metal",
      "displayName": "ApricotFields macOS Metal",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-macos-metal",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Metal",
        "LANGUAGE_BINDING": "NONE",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "apricotfields-sanitize-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "apricotfields-sanitize-tsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "apricotfields-macos-metal-asan",
      "displayName": "ApricotFields macOS ASan+UBSan",
      "inherits": ["apricotfields-sanitize-asan", "apricotfields-macos-metal"],
      "binaryDir": "${sourceDir}/build-macos-metal-asan"
    },
    {
      "name": "apricotfields-macos-metal-tsan",
      "displayName": "ApricotFields macOS TSan",
      "inherits": ["apricotfields-sanitize-tsan", "apricotfields-macos-metal"],
      "binaryDir": "${sourceDir}/build-macos-metal-tsan"
    },
    {
      "name": "apricotfields-linux-vulkan-asan",
      "displayName": "ApricotFields Linux ASan+UBSan",
      "inherits": ["apricotfields-sanitize-asan", "apricotfields-linux-vulkan"],
      "binaryDir": "${sourceDir}/build-linux-vulkan-asan"
    },
    {
      "name": "apricotfields-linux-vulkan-tsan",
      "displayName": "ApricotFields Linux TSan",
      "inherits": ["apricotfields-sanitize-tsan", "apricotfields-linux-vulkan"],
      "binaryDir": "${sourceDir}/build-linux-vulkan-tsan"
    },
    {
      "name": "apricotfields-sanitize-fuzz",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "APRICOTFIELDS_BUILD_TESTS": "OFF",
        "APRICOTFIELDS_BUILD_FUZZERS": "ON",
        "SPUDLIB_BUILD_TESTS": "OFF",
        "CMAKE_C_FLAGS": "-O1 -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-O1 -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-O1 -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-O1 -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "apricotfields-macos-metal-fuzz",
      "displayName": "ApricotFields macOS libFuzzer (Homebrew LLVM)",
      "inherits": ["apricotfields-sanitize-fuzz", "apricotfields-macos-metal"],
      "binaryDir": "${sourceDir}/build-macos-fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_OBJC_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_OBJCXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++"
      }
    },
    {
      "name": "apricotfields-linux-vulkan-fuzz",
      "displayName": "ApricotFields Linux libFuzzer (Clang)",
      "inherits": ["apricotfields-sanitize-fuzz", "apricotfields-linux-vulkan"],
      "binaryDir": "${sourceDir}/build-linux-fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "apricotfields-windows-sanitize-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "/Ob0 /Od /fsanitize=address",
        "CMAKE_CXX_FLAGS_DEBUG": "/Ob0 /Od /fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO",
        "CMAKE_MODULE_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO"
      }
    },
    {
      "name": "apricotfields-windows-d3d12-asan",
      "displayName": "ApricotFields Windows D3D12 ASan",
      "inherits": [
        "apricotfields-windows-sanitize-asan",
        "apricotfields-windows-d3d12"
      ],
      "binaryDir": "${sourceDir}/build-windows-d3d12-asan"
    },
    {
      "name": "apricotfields-windows-vulkan-asan",
      "displayName": "ApricotFields Windows Vulkan ASan",
      "inherits": [
        "apricotfields-windows-sanitize-asan",
        "apricotfields-windows-vulkan"
      ],
      "binaryDir": "${sourceDir}/build-windows-vulkan-asan"
    },
    {
      "name": "apricotfields-windows-d3d12-fuzz",
      "displayName": "ApricotFields Windows libFuzzer (clang)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-windows-fuzz",
      "cacheVariables": {
        "APRICOTFIELDS_BUILD_TESTS": "OFF",
        "APRICOTFIELDS_BUILD_FUZZERS": "ON",
        "SPUDLIB_BUILD_TESTS": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-sanitize-coverage=indirect-calls,trace-cmp",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-sanitize-coverage=indirect-calls,trace-cmp -D_DISABLE_STRING_ANNOTATION -D_DISABLE_VECTOR_ANNOTATION",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "GRAPHICS_BACKEND": "D3D12",
        "LANGUAGE_BINDING": "NONE",
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
