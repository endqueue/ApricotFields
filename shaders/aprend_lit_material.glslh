// The material set of Aprend's lit shaders (aprendlit.h), set 1, for the
// shaders that read it: the surface, and the cut-out depth pass.
// aprendlit.cpp's aprend_lit_material_block mirrors the block.

// Bits of AprendLitMaterial.maps: which maps hold a texture of the caller's.
// A map left out is not read, and its binding holds a placeholder.
const uint MAP_BASE_COLOR = 1u;
const uint MAP_NORMAL     = 2u;
const uint MAP_ORM        = 4u;
const uint MAP_EMISSION   = 8u;

layout(set = 1, binding = 0) uniform AprendLitMaterial {
    vec4 base_color;      // rgb linear, a: opacity
    vec4 emission;        // rgb linear
    vec4 sheen;           // rgb: sheen color, linear. a: sheen roughness
    float roughness;
    float metalness;
    float specular;       // a dielectric's reflectance: 0.5 is F0 0.04
    float normal_scale;
    float occlusion_strength;
    float alpha_cutoff;   // 0: blended by opacity; above: a cut-out
    float clearcoat;      // 0 to 1: how much of a clear coat there is
    float clearcoat_roughness;
    uint maps;
    vec4 uv_transform[2]; // rows of a 2x3 matrix, before every map
    // Each map's own, after uv_transform: rows 2m and 2m + 1 for map m
    // (base color, normal, ORM, emission, as the MAP_ bits number them).
    vec4 map_uv_transform[8];
    // glTF's KHR_materials_transmission and _volume: x how much light
    // passes through, 0 to 1; y the index of refraction; z the thickness,
    // in the scene's units; w the distance light travels before it is
    // tinted to the attenuation color, 0 for never.
    vec4 transmission;
    vec4 attenuation;     // rgb: the color light is tinted to over w's distance
} u_lit_material;
layout(set = 1, binding = 1) uniform texture2D base_color_map;
layout(set = 1, binding = 2) uniform texture2D normal_map;
layout(set = 1, binding = 3) uniform texture2D orm_map;
layout(set = 1, binding = 4) uniform texture2D emission_map;
layout(set = 1, binding = 5) uniform sampler material_sampler;

// Map indices of map_uv_transform, in MAP_ bit order.
const uint MAP_INDEX_BASE_COLOR = 0u;
const uint MAP_INDEX_NORMAL     = 1u;
const uint MAP_INDEX_ORM        = 2u;
const uint MAP_INDEX_EMISSION   = 3u;

vec2 material_uv(vec2 uv) {
    return vec2(dot(u_lit_material.uv_transform[0].xyz, vec3(uv, 1.0)), dot(u_lit_material.uv_transform[1].xyz, vec3(uv, 1.0)));
}

// Where map [map] is read for [uv], after material_uv().
vec2 map_uv(vec2 uv, uint map) {
    return vec2(dot(u_lit_material.map_uv_transform[2u * map].xyz, vec3(uv, 1.0)),
                dot(u_lit_material.map_uv_transform[2u * map + 1u].xyz, vec3(uv, 1.0)));
}
